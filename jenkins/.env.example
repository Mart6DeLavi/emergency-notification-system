# Jenkins stack environment (copy to jenkins/.env).
# Secrets are generated in the Jenkins UI when you create the agent nodes.

# Agent secrets (Manage Jenkins -> Nodes -> <agent> -> secret)
JENKINS_AGENT_GRADLE_SECRET=
JENKINS_AGENT_RUST_SECRET=

# GID of /var/run/docker.sock on the host (stat -c '%g' /var/run/docker.sock)
DOCKER_GID=988
