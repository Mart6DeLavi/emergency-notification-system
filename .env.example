# ---------------------------------------------------------------------------
# SENSA full-stack environment (copy to .env and fill in).
# Used by the root docker-compose.yml.
# ---------------------------------------------------------------------------

# PostgreSQL (single instance, databases created by docker/postgres/init.sql)
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# Shared JWT signing secret (must be >= 32 bytes for HS256)
JWT_USER_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# RabbitMQ (non-guest user so services can connect inside the docker network)
RABBITMQ_USERNAME=sensa
RABBITMQ_PASSWORD=sensa

# Amazon S3 (filesystem-service). Required for real uploads to work.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_BUCKET=

# SMTP (message-delivery-service email channel, optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Firebase Cloud Messaging (message-delivery-service push channel, optional)
FCM_API_KEY=
FCM_PROJECT_ID=

# Rescue web panel API base (browser-visible address of the api-gateway)
NUXT_PUBLIC_API_BASE=http://localhost:8080

# Logging level for Rust services
RUST_LOG=info
